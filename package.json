{
  "name": "curse-remastered",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev": "pnpm --filter @curse/game dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "inspect": "pnpm --filter @curse/asset-extractor inspect",
    "inventory": "pnpm --filter @curse/asset-extractor inventory",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "typescript-eslint": "^8.46.0"
  }
}
