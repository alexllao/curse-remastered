{
  "name": "curse-remastered",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev": "pnpm --filter @curse/game dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "inspect": "pnpm --filter @curse/asset-extractor inspect",
    "inventory": "pnpm --filter @curse/asset-extractor inventory",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "prepare": "husky",
    "check": "pnpm assets:check && pnpm lint && pnpm format:check && pnpm typecheck && pnpm build",
    "mods:prepare": "pnpm --filter @curse/asset-extractor prepare-playtest",
    "assets:prepare": "node tools/prepare-assets.mjs",
    "assets:check": "node tools/check-assets.mjs",
    "test": "pnpm -r --if-present test && node --test tools/tests/*.test.mjs",
    "audio:setup": "powershell -NoProfile -File tools/setup-mt32.ps1",
    "audio:prepare": "node tools/prepare-audio.mjs"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "typescript-eslint": "^8.46.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.4"
  },
  "lint-staged": {
    "**/*.{ts,tsx,js,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "**/*.{json,md,yml,yaml,css,html}": "prettier --write"
  },
  "author": {
    "name": "Ã€lex LlaÃ³",
    "email": "alexllao@me.com"
  }
}
