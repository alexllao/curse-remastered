    "palette-effects-verify": "tsx src/palette-effects-verify.ts",
    "spr-decode-ui": "tsx src/spr-decode-ui.ts",
    "spr-decode-ui-context": "tsx src/spr-decode-ui-context.ts",
    "scene-backgrounds": "tsx src/scene-backgrounds.ts",
    "brd-extract": "tsx src/brd-extract.ts",
    "prepare-playtest": "tsx src/prepare-playtest.ts",
    "boxdet-extract": "tsx src/boxdet-extract.ts",
    "navigation-verify": "tsx ../../tools/reverse-engineering/verify-navigation.mts",
    "scene-layers": "tsx src/scene-layers.ts"
