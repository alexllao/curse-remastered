{
  "name": "@curse/asset-extractor",
  "private": true,
  "type": "module",
  "scripts": {
    "inspect": "tsx src/inspect.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "inventory": "tsx src/inventory.ts",
    "rnc-info": "tsx src/rnc-info.ts",
    "title-png": "tsx src/title-png.ts",
    "extract-all": "tsx src/extract-all.ts",
    "images-png": "tsx src/images-png.ts",
    "analyze-map-spr": "tsx src/analyze-map-spr.ts",
    "spr-index": "tsx src/spr-index.ts",
    "spr-stream": "tsx src/spr-stream.ts",
    "spr-layout": "tsx src/spr-layout.ts",
    "spr-rows": "tsx src/spr-rows.ts",
    "spr-preview": "tsx src/spr-preview.ts",
    "spr-compare": "tsx src/spr-compare.ts",
    "analyze-exe": "tsx src/analyze-exe.ts",
    "spr-decode": "tsx src/spr-decode.ts",
    "spr-decode-all": "tsx src/spr-decode-all.ts",
    "spr-atlas": "tsx src/spr-atlas.ts",
    "spr-palette-audit": "tsx src/spr-palette-audit.ts",
    "exe-palettes": "tsx src/exe-palettes.ts",
